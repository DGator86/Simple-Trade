# Massive (formerly Polygon.io) REST API key
MASSIVE_API_KEY=
# Alpaca market data keys (paper keys work for data)
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
# Alpaca feed: "iex" (free) or "sip" (paid subscription)
ALPACA_FEED=iex
# Tradier brokerage API token
TRADIER_TOKEN=
# Optional: set to "sandbox" to use sandbox.tradier.com
TRADIER_ENV=
# Where Parquet files are written
SIMPLE_TRADE_DATA_DIR=data
